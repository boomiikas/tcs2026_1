# Environment Configuration for RetailMind AI
APP_ENV=development
DEBUG=true
PORT=8000
HOST=0.0.0.0

# Database Configuration (PostgreSQL 16+)
# Default to PostgreSQL, with automatic fallback support for SQLite during standalone offline unit tests
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/retailmind
SYNC_DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/retailmind
DATABASE_ECHO=false

# Redis Configuration (Celery & Caching)
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# LLM Configuration (Groq API - Direct Integration)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b
LLM_PROVIDER=groq
LLM_TEMPERATURE=0.1

# WhatsApp Meta Cloud API Configuration
WHATSAPP_TOKEN=your_meta_whatsapp_cloud_token_here
WHATSAPP_PHONE_NUMBER_ID=your_whatsapp_phone_number_id_here
WHATSAPP_VERIFY_TOKEN=retailmind_meta_webhook_verify_secret
WHATSAPP_API_VERSION=v21.0
# When USE_MOCK_WHATSAPP is true, simulated WhatsApp interactive responses work offline without Meta API credentials
USE_MOCK_WHATSAPP=true

# Security & CORS
SECRET_KEY=dev-retailmind-super-secret-key-32-chars-long!
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173
